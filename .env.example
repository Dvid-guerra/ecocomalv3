# Firebase Web SDK (valores públicos usados por el cliente)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin (solo servidor; nunca usar el prefijo NEXT_PUBLIC_)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# En proveedores que escapan saltos de línea, se acepta el formato: -----BEGIN...\n...\n-----END...
FIREBASE_ADMIN_PRIVATE_KEY=

# Asistente IA (solo servidor)
GOOGLE_GENERATIVE_AI_API_KEY=
# Opcional. Por defecto: gemini-flash-latest
AGENTE_MODELO=
# Opcional: low | medium | high (por defecto low; "minimal" no lo aceptan todos los modelos)
AGENTE_RAZONAMIENTO=
# Opcional: modelo de respaldo si el principal está saturado (por defecto gemini-2.5-flash)
AGENTE_MODELO_RESPALDO=
